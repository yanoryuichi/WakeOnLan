; WakeOnLan 設定ファイル
; このファイルを config.ini にコピーして編集してください。
; セクション名 = マシン名。 WakeOnLan.ps1 -Name <セクション名> で指定します (省略時は最初のセクション)。

[MyPC1]
; 必須: 起動したいマシンの MAC アドレス (区切りは - または :)
Mac=AA-BB-CC-DD-EE-FF
; マジックパケットの送信先 (省略時 255.255.255.255)
Broadcast=192.168.1.255
; 送信先 UDP ポート (省略時 9)
Port=9
; 通知に表示する名前 (省略時はセクション名)
DisplayName=MyPC1
; RDP の接続確認先。省略するとパケット送信のみで終了し、通知しません
RdpHost=192.168.1.100
; RDP ポート (省略時 3389)
RdpPort=3389
; 接続確認のタイムアウト秒 (省略時 60)
RdpTimeoutSec=60

[MyPC2]
Mac=AA-BB-CC-DD-EE-00
